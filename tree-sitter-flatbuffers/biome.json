{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "extends": ["../flatbuffers-formatter/biome.json"],
  "files": {
    "includes": [
      "**",
      "!node_modules/**",
      "!src/**",
      "!build/**",
      "!**/*.scm"
    ]
  },
  "overrides": [
    {
      "includes": ["grammar.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
