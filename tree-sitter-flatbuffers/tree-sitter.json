{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "flatbuffers",
      "camelcase": "FlatBuffers",
      "scope": "source.fbs",
      "path": ".",
      "file-types": ["fbs"],
      "highlights": ["queries/highlights.scm"],
      "injections": ["queries/injections.scm"],
      "tags": ["queries/tags.scm"],
      "injection-regex": "^(flatbuffers|fbs)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for FlatBuffers (.fbs) schema files.",
    "authors": [{ "name": "emindeniz99" }],
    "links": {
      "repository": "https://github.com/emindeniz99/playground",
      "homepage": "https://github.com/emindeniz99/playground/tree/main/projects/tree-sitter-flatbuffers"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
