{
  "name": "flatbuffers-format-editors",
  "version": "0.1.0",
  "description": "Browser editor integrations for FlatBuffers schemas: CodeMirror 6 language extension, Monaco Monarch tokenizer, and a <flatbuffers-editor> Web Component. Delegates to the flatbuffers-format engine for formatting; bring your own renderer.",
  "keywords": [
    "flatbuffers",
    "fbs",
    "codemirror",
    "codemirror-6",
    "monaco",
    "monaco-editor",
    "web-component",
    "custom-element",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/flatbuffers-format.git",
    "directory": "flatbuffers-format-editors"
  },
  "homepage": "https://github.com/emindeniz99/flatbuffers-format/tree/main/flatbuffers-format-editors#readme",
  "bugs": {
    "url": "https://github.com/emindeniz99/flatbuffers-format/issues"
  },
  "type": "module",
  "exports": {
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "lint": "biome lint src test",
    "format:src": "biome format --write src test",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "flatbuffers-format": "workspace:^",
    "monaco-editor": "*"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.30.0",
    "@lezer/highlight": "^1.2.0",
    "@types/node": "^22.10.0",
    "flatbuffers-format": "workspace:^",
    "monaco-editor": "^0.56.0",
    "typescript": "^5.6.0"
  }
}
