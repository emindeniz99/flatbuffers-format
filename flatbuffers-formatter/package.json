{
  "name": "flatbuffers-formatter-antlr",
  "version": "0.1.0",
  "private": true,
  "description": "FlatBuffers (.fbs) formatter using an ANTLR-generated parser. TypeScript, browser + CLI.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "fbs-fmt-antlr": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "grammar"
  ],
  "scripts": {
    "generate": "antlr-ng -Dlanguage=TypeScript -o generated grammar/FlatBuffers.g4",
    "build": "npm run generate && tsc",
    "fmt": "node dist/src/cli.js",
    "test": "npm run generate && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "antlr-ng": "^1.0.10",
    "typescript": "^5.6.0"
  }
}
