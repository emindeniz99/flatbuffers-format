{
  "name": "flatbuffers-format-handrolled",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-rolled recursive-descent FlatBuffers (.fbs) formatter. Kept as a differential oracle for the published flatbuffers-format (ANTLR-backed) — not published to npm.",
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/playground.git",
    "directory": "projects/flatbuffers-formatter"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "flatbuffers-format-handrolled": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "fmt": "node dist/cli.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
