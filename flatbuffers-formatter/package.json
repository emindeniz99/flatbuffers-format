{
  "name": "flatbuffers-format",
  "version": "0.1.0",
  "description": "Opinionated FlatBuffers (.fbs) schema formatter, built on an ANTLR4 grammar. Pure TypeScript runtime (antlr4ng) \u2014 no JVM, no codegen at install time. Runs in Node and the browser, ships a CLI.",
  "keywords": [
    "flatbuffers",
    "fbs",
    "formatter",
    "schema",
    "pretty-printer",
    "cli",
    "antlr",
    "antlr4",
    "antlr4ng"
  ],
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/flatbuffers-format.git",
    "directory": "flatbuffers-formatter"
  },
  "homepage": "https://github.com/emindeniz99/flatbuffers-format/tree/main/flatbuffers-formatter#readme",
  "bugs": {
    "url": "https://github.com/emindeniz99/flatbuffers-format/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "flatbuffers-format": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "grammar",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "antlr-ng -Dlanguage=TypeScript -o generated grammar/FlatBuffers.g4",
    "build": "pnpm run generate && tsc",
    "fmt": "node dist/src/cli.js",
    "lint": "biome lint src test",
    "lint:fix": "biome check --write src test",
    "format:src": "biome format --write src test",
    "test": "pnpm run generate && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "build:sibling": "pnpm --filter flatbuffers-format-handrolled build",
    "test:crosscheck": "bash test/crosscheck.sh",
    "test:flatc-conform": "bash scripts/flatc-conform.sh",
    "bench": "node scripts/bench.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run build:sibling && pnpm run test:crosscheck"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.10.0",
    "antlr-ng": "^1.0.10",
    "typescript": "^5.6.0"
  }
}
