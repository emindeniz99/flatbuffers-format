{
  "name": "flatbuffers-format",
  "version": "0.1.0",
  "description": "Opinionated FlatBuffers (.fbs) schema formatter, built on an ANTLR4 grammar. Pure TypeScript runtime (antlr4ng) — no JVM, no codegen at install time. Runs in Node and the browser, ships a CLI.",
  "keywords": [
    "flatbuffers",
    "fbs",
    "formatter",
    "schema",
    "pretty-printer",
    "cli",
    "antlr",
    "antlr4",
    "antlr4ng"
  ],
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/playground.git",
    "directory": "projects/flatbuffers-formatter"
  },
  "homepage": "https://github.com/emindeniz99/playground/tree/main/projects/flatbuffers-formatter#readme",
  "bugs": {
    "url": "https://github.com/emindeniz99/playground/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "flatbuffers-format": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "grammar",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "antlr-ng -Dlanguage=TypeScript -o generated grammar/FlatBuffers.g4",
    "build": "npm run generate && tsc",
    "fmt": "node dist/src/cli.js",
    "test": "npm run generate && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "build:sibling": "cd ../flatbuffers-formatter-handrolled && npm ci --no-audit --no-fund && npm run build",
    "test:crosscheck": "bash test/crosscheck.sh",
    "test:flatc-conform": "bash scripts/flatc-conform.sh",
    "prepublishOnly": "npm run build && npm test && npm run build:sibling && npm run test:crosscheck"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "antlr-ng": "^1.0.10",
    "typescript": "^5.6.0"
  }
}
