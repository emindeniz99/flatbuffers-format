{
  "name": "flatbuffers-formatter",
  "version": "0.1.0",
  "private": true,
  "description": "A FlatBuffers (.fbs) schema formatter. Pure TypeScript, runs in browser or Node, ships with a CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fbs-fmt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "fmt": "node dist/cli.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
