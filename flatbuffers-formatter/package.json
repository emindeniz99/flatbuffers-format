{
  "name": "flatbuffers-format-antlr",
  "version": "0.1.0",
  "description": "FlatBuffers (.fbs) schema formatter built on an ANTLR4-generated parser. Sibling of flatbuffers-format with the same output and CLI surface.",
  "keywords": [
    "flatbuffers",
    "fbs",
    "formatter",
    "schema",
    "antlr",
    "antlr4",
    "antlr4ng",
    "pretty-printer",
    "cli"
  ],
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/playground.git",
    "directory": "projects/flatbuffers-formatter-antlr"
  },
  "homepage": "https://github.com/emindeniz99/playground/tree/main/projects/flatbuffers-formatter-antlr#readme",
  "bugs": {
    "url": "https://github.com/emindeniz99/playground/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "flatbuffers-format-antlr": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "grammar",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "antlr-ng -Dlanguage=TypeScript -o generated grammar/FlatBuffers.g4",
    "build": "npm run generate && tsc",
    "fmt": "node dist/src/cli.js",
    "test": "npm run generate && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "antlr-ng": "^1.0.10",
    "typescript": "^5.6.0"
  }
}
