{
  "name": "flatbuffers-format",
  "version": "0.1.0",
  "description": "Opinionated FlatBuffers (.fbs) schema formatter. Pure TypeScript, zero runtime deps, runs in Node and the browser, ships a CLI.",
  "keywords": [
    "flatbuffers",
    "fbs",
    "formatter",
    "schema",
    "pretty-printer",
    "cli"
  ],
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/playground.git",
    "directory": "projects/flatbuffers-formatter"
  },
  "homepage": "https://github.com/emindeniz99/playground/tree/main/projects/flatbuffers-formatter#readme",
  "bugs": {
    "url": "https://github.com/emindeniz99/playground/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "flatbuffers-format": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "fmt": "node dist/cli.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
