{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "pull-request-title-pattern": "chore(${component}): release ${version}",
  "separate-pull-requests": false,
  "packages": {
    "flatbuffers-formatter": {
      "release-type": "node",
      "package-name": "flatbuffers-format",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "prettier-plugin-flatbuffers": {
      "release-type": "node",
      "package-name": "prettier-plugin-flatbuffers",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "tree-sitter-flatbuffers": {
      "release-type": "node",
      "package-name": "tree-sitter-flatbuffers",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "tree-sitter.json",
          "jsonpath": "$.metadata.version"
        }
      ]
    },
    "vscode-flatbuffers": {
      "release-type": "node",
      "package-name": "vscode-flatbuffers",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "intellij-flatbuffers": {
      "release-type": "simple",
      "package-name": "intellij-flatbuffers",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        "gradle.properties"
      ]
    },
    "flatbuffers-format-editors": {
      "release-type": "node",
      "package-name": "flatbuffers-format-editors",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    }
  }
}
