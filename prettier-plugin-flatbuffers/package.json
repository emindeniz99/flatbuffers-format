{
  "name": "prettier-plugin-flatbuffers",
  "version": "0.1.0",
  "description": "Prettier plugin that formats FlatBuffers (.fbs) schemas via the flatbuffers-format engine.",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "flatbuffers",
    "fbs",
    "formatter"
  ],
  "license": "MIT",
  "author": "emindeniz99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/flatbuffers-format.git",
    "directory": "prettier-plugin-flatbuffers"
  },
  "homepage": "https://github.com/emindeniz99/flatbuffers-format/tree/main/prettier-plugin-flatbuffers#readme",
  "bugs": {
    "url": "https://github.com/emindeniz99/flatbuffers-format/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "lint": "biome lint src test",
    "lint:fix": "biome check --write src test",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "dependencies": {
    "flatbuffers-format": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.19.19",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
