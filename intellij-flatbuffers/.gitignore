# Gradle. The wrapper jar + scripts are generated on demand (CI runs
# `gradle wrapper --gradle-version 8.10.2`); committing the binary
# jar would be a maintenance smell, so we leave it out here.
.gradle/
.kotlin/
build/
gradle/wrapper/
gradlew
gradlew.bat

# IntelliJ Platform Gradle Plugin caches
.intellijPlatform/

# IDE
.idea/
*.iml
*.iws
out/

# OS
.DS_Store
Thumbs.db

# Sandbox IDE state from `./gradlew runIde`
.sandbox/
