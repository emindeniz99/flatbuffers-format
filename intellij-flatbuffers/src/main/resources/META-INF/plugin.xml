<idea-plugin>
  <!--
    Plugin descriptor for IntelliJ-family IDEs (IDEA, Rider, WebStorm,
    PyCharm, GoLand, CLion, RustRover, RubyMine, PhpStorm, Aqua, Fleet
    via legacy-IJ-plugin compat). The single `<depends>` line on
    `com.intellij.modules.platform` is enough — every IntelliJ-family
    IDE includes that module by definition, so a single .zip ships
    everywhere.

    Why not a separate Rider-only variant: the Marketplace allows
    targeting multiple IDEs with one upload as long as the plugin only
    uses platform APIs (which is the case here — we never touch C#
    language services or anything Rider-specific). One artifact, one
    listing, one CI job.
  -->

  <!-- PERMANENT after the first Marketplace upload — it cannot be
       changed later, so it matches the rest of the project (repo,
       npm family, Gradle group, and the <name> below) rather than
       being abbreviated.

       It deliberately does NOT mirror the Kotlin package
       `io.github.emindeniz99.intellij.*`: Marketplace policy (since
       2024-03-26) rejects plugin IDs containing the word "intellij",
       because that implies an official JetBrains plugin. The package
       stays as it is — a code namespace is not a Marketplace ID. -->
  <id>io.github.emindeniz99.flatbuffers</id>
  <name>FlatBuffers Format</name>
  <vendor email="emindeniz99@gmail.com" url="https://github.com/emindeniz99/flatbuffers-format/tree/main/intellij-flatbuffers">emindeniz99</vendor>

  <description><![CDATA[
    <p>
      Syntax highlighting and code formatting for FlatBuffers
      (<code>.fbs</code>) schema files. Formatting runs through the
      platform's own formatting service, so <i>Reformat Code</i>
      (<kbd>Ctrl/⌘+Alt+L</kbd>) works, and enabling
      <i>Settings → Tools → Actions on Save → Reformat code</i> gives you
      format-on-save with no extra plugin. The formatter delegates to the
      <a href="https://www.npmjs.com/package/flatbuffers-format"><code>flatbuffers-format</code></a>
      CLI for byte-for-byte parity with the published engine — same
      output you'd get from the VS Code extension, Prettier plugin,
      <code>npx flatbuffers-format</code>, or the pre-commit hook.
    </p>

    <h3>Features</h3>
    <ul>
      <li>Recognises <code>.fbs</code> as the <b>FlatBuffers</b> language.</li>
      <li>Syntax highlighting (keywords, types, attributes, numbers,
        strings, comments) via a hand-rolled lexer mirroring the engine
        grammar.</li>
      <li>Format the current file with <kbd>Ctrl/⌘ + Alt + L</kbd> (the
        usual <i>Reformat Code</i> shortcut) — shells out to
        <code>flatbuffers-format</code> asynchronously.</li>
      <li>Settings page at <i>Preferences → Tools → FlatBuffers</i>
        for engine discovery and every format option the engine
        exposes.</li>
      <li>Reads the project's <code>.flatbuffers-format.json</code>, so a
        team commits its format options once and the IDE formats exactly
        as the CLI and CI do.</li>
    </ul>

    <h3>Prerequisites</h3>
    <p>
      None, on a machine with Node 20+: the plugin ships the formatter as a
      JavaScript bundle and runs it on the Node you already have — including
      one installed by nvm, fnm, Volta, asdf, nodenv or mise, which an IDE
      launched from the Dock or a desktop shortcut cannot see on its own
      <code>PATH</code>. Otherwise:
    </p>
    <ul>
      <li>
        <b>Click "Download bundled engine"</b> on the settings page
        (Preferences → Tools → FlatBuffers). The plugin fetches the
        matching native binary from the engine's GitHub Release and
        caches it under the IDE system directory. No Node, no npm
        required.
      </li>
      <li>
        <b>Or install via npm</b> if you prefer to manage updates
        yourself: <code>npm install -g flatbuffers-format</code>.
        Auto-detected on <code>PATH</code> after install.
      </li>
    </ul>

    <h3>Supported IDEs</h3>
    <p>
      All JetBrains IDEs built on the IntelliJ Platform 2024.2 or newer:
      IntelliJ IDEA (Community + Ultimate), Rider, WebStorm, PyCharm,
      GoLand, CLion, RustRover, RubyMine, PhpStorm, Aqua, DataGrip,
      DataSpell, MPS, and the Android Studio fork (2024.2-aligned).
    </p>
  ]]></description>

  <!-- <change-notes> is generated at build time from the CHANGELOG.md
       files release-please writes (`changeNotesHtml` in build.gradle.kts).
       Don't add one here. -->

  <!-- The lone hard dependency: every IntelliJ-family IDE ships this.
       Adding more `<depends>` lines is a footgun — it restricts which
       IDEs can install the plugin. -->
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- File type registration: anything ending in .fbs is a FlatBuffers
         schema. The fileType reference is the language ID (not the
         class FQN). -->
    <fileType
        name="FlatBuffers"
        implementationClass="io.github.emindeniz99.intellij.FlatBuffersFileType"
        fieldName="INSTANCE"
        language="FlatBuffers"
        extensions="fbs"/>

    <!-- When another FlatBuffers plugin is installed, .fbs files take its
         file type: it highlights and navigates, we keep formatting. See
         DeferToOtherFlatBuffersPlugin. -->
    <fileTypeOverrider
        implementation="io.github.emindeniz99.intellij.DeferToOtherFlatBuffersPlugin"/>

    <!-- Lexer-backed syntax highlighter. -->
    <lang.syntaxHighlighterFactory
        language="FlatBuffers"
        implementationClass="io.github.emindeniz99.intellij.FlatBuffersSyntaxHighlighterFactory"/>

    <!-- Color settings page (Preferences → Editor → Color Scheme →
         FlatBuffers). Lets users override token colors. -->
    <colorSettingsPage
        implementation="io.github.emindeniz99.intellij.FlatBuffersColorSettingsPage"/>

    <!-- Line/block commenter. Wires up Ctrl+/ and Ctrl+Shift+/. -->
    <lang.commenter
        language="FlatBuffers"
        implementationClass="io.github.emindeniz99.intellij.FlatBuffersCommenter"/>

    <!-- External formatter wiring. AsyncDocumentFormattingService is the
         supported integration point since 2022.2 — it runs the formatter
         off the EDT, lets the user cancel mid-format, and reports
         failures via the IDE's standard error infrastructure. -->
    <formattingService
        implementation="io.github.emindeniz99.intellij.FlatBuffersFormattingService"/>

    <!-- App-level (not project-level) settings: CLI path is a global
         tool, not a per-project concern. Mirror Prettier-plugin layout. -->
    <applicationService
        serviceImplementation="io.github.emindeniz99.intellij.FlatBuffersSettings"/>

    <!-- Settings UI under Preferences → Tools → FlatBuffers. Registered
         per project only so the page knows which project it is shown
         for and can say when a .flatbuffers-format.json overrides it;
         what it edits is still the app-level service above. -->
    <projectConfigurable
        parentId="tools"
        instance="io.github.emindeniz99.intellij.FlatBuffersConfigurable"
        id="io.github.emindeniz99.intellij.FlatBuffersConfigurable"
        displayName="FlatBuffers"/>

    <!-- Notification group referenced by the formatting service when
         the CLI shells out and exits non-zero, or isn't found. BALLOON
         = transient bottom-right popup; users dismiss without action. -->
    <notificationGroup
        id="FlatBuffers"
        displayType="BALLOON"
        isLogByDefault="true"/>
  </extensions>
</idea-plugin>
